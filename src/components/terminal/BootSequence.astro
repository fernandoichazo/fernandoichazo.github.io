---
// Encendido del tubo (~1.15s): línea horizontal que se abre a pantalla completa
// y diagnóstico rápido. Solo se ejecuta cuando TerminalLayout marca data-boot="run"
// (primera visita de la sesión, sin reducción de movimiento). Se omite con clic o tecla.
import { system } from '@data/site';
---

<div class="boot" aria-hidden="true">
  <div class="boot__beam"></div>
  <div class="boot__log">
    {system.diagnostics.map((line, i) => <p style={`--i:${i}`}>{line}</p>)}
  </div>
  <p class="boot__skip">[ESPACIO] O CLIC PARA OMITIR</p>
</div>

<style>
  .boot {
    display: none;
  }

  :global(:root[data-boot='run']) .boot {
    position: fixed;
    inset: var(--tube-top) var(--tube-inset) var(--tube-inset);
    z-index: 40;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--gutter);
    border-radius: var(--tube-radius);
    overflow: hidden;
    /* El cristal apagado, un tono sobre el vacío: se lee el borde redondeado del tubo. */
    background: var(--surface);
    box-shadow: 0 0 0 100vmax var(--void);
    cursor: pointer;
    animation: boot-fade 0.2s var(--ease-out) 0.95s forwards;
  }

  .boot__beam {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    background: var(--phosphor);
    box-shadow: 0 0 24px var(--phosphor);
    transform: scaleX(0);
    animation:
      beam-open 0.18s var(--ease-out) forwards,
      beam-fill 0.34s ease-in 0.18s forwards;
  }

  .boot__log {
    font-size: var(--step-1);
    line-height: 1.7;
  }
  .boot__log p {
    opacity: 0;
    animation: line-on 0.01s linear forwards;
    animation-delay: calc(0.32s + var(--i) * 0.18s);
  }

  .boot__skip {
    position: absolute;
    bottom: calc(var(--gutter) * 0.75);
    left: var(--gutter);
    font-size: var(--step--1);
    color: var(--phosphor-soft);
    opacity: 0;
    animation: line-on 0.01s linear 0.2s forwards;
  }

  @keyframes beam-open {
    to { transform: scaleX(1); }
  }
  @keyframes beam-fill {
    from { transform: scaleX(1) scaleY(1); opacity: 0.9; }
    to { transform: scaleX(1) scaleY(420); opacity: 0; }
  }
  @keyframes line-on {
    to { opacity: 1; }
  }
  @keyframes boot-fade {
    to { opacity: 0; visibility: hidden; pointer-events: none; }
  }
</style>

<script>
  const root = document.documentElement;
  const overlay = document.querySelector<HTMLElement>('.boot');

  let finished = false;

  // Final natural: data-boot sigue en "run" para que la pantalla termine de imprimirse.
  // Omitir: data-boot pasa a "skip" y todo aparece de inmediato.
  const finish = (skipped: boolean) => {
    if (finished) return;
    finished = true;
    if (skipped) root.dataset.boot = 'skip';
    try {
      sessionStorage.setItem('pipos:booted', '1');
    } catch {
      // Sin almacenamiento: el arranque se repetirá en la próxima carga.
    }
    document.dispatchEvent(new CustomEvent('pipos:boot-done', { detail: { skipped } }));
    window.removeEventListener('keydown', onKey, true);
  };

  function onKey(event: KeyboardEvent) {
    if ([' ', 'Enter', 'Escape'].includes(event.key)) {
      event.preventDefault();
      event.stopPropagation();
      finish(true);
    }
  }

  if (root.dataset.boot === 'run' && overlay) {
    overlay.addEventListener('click', () => finish(true));
    // Coincide con --boot-duration; un temporizador es más fiable que animationend.
    window.setTimeout(() => finish(false), 1150);
    window.addEventListener('keydown', onKey, true);
  }
</script>

---
// Pantalla de una directiva cuyo contenido llega en la Fase 2.
import PhosphorText from '@components/crt/PhosphorText.astro';
import BackCommand from '@components/terminal/BackCommand.astro';
import type { Directive } from '@data/site';

interface Props {
  directive: Directive;
}

const { directive } = Astro.props;
---

<section class="module" aria-labelledby="module-title">
  <p class="log">&gt; EJECUTANDO {directive.file}... <span class="warn">MÓDULO EN PREPARACIÓN</span></p>
  <PhosphorText as="h1" id="module-title" size="display" glow="strong" class="title">
    [{directive.key}] {directive.label}
  </PhosphorText>
  <p class="body">
    ESTE ARCHIVO SE ESTÁ COMPILANDO Y ESTARÁ DISPONIBLE EN LA PRÓXIMA ACTUALIZACIÓN DEL SISTEMA.
  </p>
  <div class="actions"><BackCommand /></div>
</section>

<style>
  .module {
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .log {
    font-size: var(--step--1);
    color: var(--phosphor-soft);
  }
  .warn {
    color: var(--warning);
  }
  .title {
    margin: 1rem 0;
  }
  .body {
    max-width: 60ch;
    font-size: var(--step-1);
  }
  .actions {
    margin-top: 2rem;
  }
</style>


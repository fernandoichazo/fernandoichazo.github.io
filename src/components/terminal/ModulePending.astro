---
// Pantalla de una directiva cuyo contenido llega en la Fase 2.
import PhosphorText from '@components/crt/PhosphorText.astro';
import type { Directive } from '@data/site';

interface Props {
  directive: Directive;
}

const { directive } = Astro.props;
---

<section class="module" aria-labelledby="module-title">
  <p class="log">&gt; EJECUTANDO {directive.file}... <span class="warn">MÓDULO EN PREPARACIÓN</span></p>
  <PhosphorText as="h1" id="module-title" size="display" glow="strong" class="title">
    [{directive.key}] {directive.label}
  </PhosphorText>
  <p class="body">
    ESTE ARCHIVO SE ESTÁ COMPILANDO Y ESTARÁ DISPONIBLE EN LA PRÓXIMA ACTUALIZACIÓN DEL SISTEMA.
  </p>
  <a class="back" href="/" data-back>[ESC] VOLVER AL MENÚ PRINCIPAL</a>
</section>

<style>
  .module {
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .log {
    font-size: var(--step--1);
    color: var(--phosphor-soft);
  }
  .warn {
    color: var(--warning);
  }
  .title {
    margin: 1rem 0;
  }
  .body {
    max-width: 60ch;
    font-size: var(--step-1);
  }
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    margin-top: 2rem;
    padding: 0.25rem 0.875rem;
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.2rem + 1vw, 2rem);
    background: var(--phosphor);
    color: var(--void);
    text-shadow: none;
  }
  .back:hover {
    background: var(--void);
    color: var(--phosphor);
    box-shadow: inset 0 0 0 2px var(--phosphor);
  }
</style>

<script>
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') document.querySelector<HTMLAnchorElement>('[data-back]')?.click();
  });
</script>

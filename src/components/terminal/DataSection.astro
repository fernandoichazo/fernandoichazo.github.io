---
// Bloque de datos de un módulo: regla "=", cabecera "[X] TÍTULO ...... ARCHIVO" y contenido.
// Lo comparten las pantallas de módulo (perfil, proyectos, certificaciones).
interface Props {
  id: string;
  sectionKey: string;
  title: string;
  file: string;
}

const { id, sectionKey, title, file } = Astro.props;
const rule = '='.repeat(120);
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <p class="rule" aria-hidden="true">{rule}</p>
  <h2 class="head" id={`${id}-title`}>
    <span class="key">[{sectionKey}]</span>
    <span class="title">{title}</span>
    <span class="file">{file}</span>
  </h2>
  <div class="body">
    <slot />
  </div>
</section>

<style>
  .section {
    container-type: inline-size;
    margin-top: clamp(1.75rem, var(--screen-h) * 0.05, 3rem);
    scroll-margin-top: 1rem;
  }

  .rule {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: 0.2em;
    color: var(--phosphor-dim);
    white-space: nowrap;
    overflow: hidden;
    width: min(70rem, 100%);
  }

  .head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 1rem;
    width: min(70rem, 100%);
    margin: 0.5rem 0 1rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.2;
  }
  .file {
    font-family: var(--font-text);
    font-size: var(--step--1);
    letter-spacing: var(--tracking);
    color: var(--phosphor-soft);
  }

  .body {
    width: min(70rem, 100%);
  }

  @container (max-width: 34rem) {
    .head {
      grid-template-columns: auto 1fr;
      row-gap: 0;
    }
    .file {
      grid-column: 2;
    }
  }
</style>

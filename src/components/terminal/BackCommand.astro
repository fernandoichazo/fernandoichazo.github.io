---
// Botón de comando para volver al menú principal; también responde a [ESC].
---

<a class="back" href="/" data-back>[ESC] VOLVER AL MENÚ PRINCIPAL</a>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.25rem 0.875rem;
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.2rem + 1vw, 2rem);
    background: var(--phosphor);
    color: var(--void);
    text-shadow: none;
  }
  .back:hover {
    background: var(--void);
    color: var(--phosphor);
    box-shadow: inset 0 0 0 2px var(--phosphor);
  }
</style>

<script>
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') document.querySelector<HTMLAnchorElement>('[data-back]')?.click();
  });
</script>

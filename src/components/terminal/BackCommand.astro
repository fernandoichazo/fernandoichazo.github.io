---
// Botón de comando para volver (por defecto, al menú principal). [ESC] lo maneja TerminalLayout
// (script inline del head), que sigue el href de este botón.
import { idiomaDe, rutaDe, traducir } from '@i18n';

interface Props {
  /** Destino; por defecto, el menú principal. */
  href?: string;
  /** Texto del botón; por defecto, "[ESC] VOLVER AL MENÚ PRINCIPAL". */
  label?: string;
}

const idioma = idiomaDe(Astro);
const { href = rutaDe(idioma, 'inicio'), label = traducir(idioma).comun.volverMenu } = Astro.props;
---

<a class="back" href={href} data-back>{label}</a>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.25rem 0.875rem;
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.2rem + 1vw, 2rem);
    background: var(--phosphor);
    color: var(--void);
    text-shadow: none;
  }
  .back:hover {
    background: var(--void);
    color: var(--phosphor);
    box-shadow: inset 0 0 0 2px var(--phosphor);
  }
</style>

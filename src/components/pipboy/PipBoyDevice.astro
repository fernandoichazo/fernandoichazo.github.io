---
// Pip-Boy 3000 vectorizado a partir de pibboy3000.png (lienzo 2400×1792).
// Se incrusta como <svg> anidado dentro de otra escena SVG; x, y y width lo colocan ahí.
// Clases de animación que usa PipBoyIntro: pb-glass (cristal, referencia del acercamiento),
// pb-glow (encendido de la pantalla), pb-beam (haz de fósforo) y pb-led (halo de los botones).
interface Props {
  x?: number;
  y?: number;
  width?: number;
}

const { x = 0, y = 0, width = 2400 } = Astro.props;
const height = (width * 1792) / 2400;
---

<svg class="pb-device" x={x} y={y} width={width} height={height} viewBox="0 0 2400 1792" overflow="visible" style="text-transform: none; letter-spacing: normal">
    <defs>
      <linearGradient id="pd-shell" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#7d7553"/>
        <stop offset="0.45" stop-color="#6b6747"/>
        <stop offset="1" stop-color="#55533b"/>
      </linearGradient>
      <linearGradient id="pd-shell-h" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#5a583e"/>
        <stop offset="0.35" stop-color="#6e6b4a"/>
        <stop offset="1" stop-color="#4c4a35"/>
      </linearGradient>
      <linearGradient id="pd-panel" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#6a6646"/>
        <stop offset="0.6" stop-color="#5f5c40"/>
        <stop offset="1" stop-color="#47452f"/>
      </linearGradient>
      <linearGradient id="pd-panel-r" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#4f4c36"/>
        <stop offset="0.5" stop-color="#6e6b4a"/>
        <stop offset="1" stop-color="#7b7553"/>
      </linearGradient>
      <linearGradient id="pd-cuff" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#5c5a3f"/>
        <stop offset="0.5" stop-color="#77714f"/>
        <stop offset="1" stop-color="#6a6646"/>
      </linearGradient>
      <linearGradient id="pd-lower" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#4a4833"/>
        <stop offset="1" stop-color="#5c5a3f"/>
      </linearGradient>
      <linearGradient id="pd-btnpanel" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#77714f"/>
        <stop offset="1" stop-color="#615f42"/>
      </linearGradient>
      <radialGradient id="pd-glass" cx="0.5" cy="0.5" r="0.62">
        <stop offset="0" stop-color="#16301f"/>
        <stop offset="0.55" stop-color="#0c1810"/>
        <stop offset="1" stop-color="#050906"/>

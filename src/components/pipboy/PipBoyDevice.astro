        <stop offset="1" stop-color="#8d8b7c"/>
      </radialGradient>
      <g id="pd-screw-g">
        <circle r="44" fill="#2a2b1e"/>
        <circle r="31" fill="url(#pd-screw)"/>
        <path d="M-22 -22 L22 22" stroke="#3e3f2d" stroke-width="9" stroke-linecap="round"/>

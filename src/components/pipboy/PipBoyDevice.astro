      <radialGradient id="pd-glass-on" cx="0.5" cy="0.48" r="0.62">
        <stop offset="0" stop-color="#1bff80" stop-opacity="0.55"/>
        <stop offset="0.55" stop-color="#0f7740" stop-opacity="0.35"/>
        <stop offset="1" stop-color="#020503" stop-opacity="0"/>
      </radialGradient>
      <linearGradient id="pd-beam" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1bff80" stop-opacity="0"/>
        <stop offset="0.5" stop-color="#1bff80"/>
        <stop offset="1" stop-color="#1bff80" stop-opacity="0"/>
      </linearGradient>
      <radialGradient id="pd-btn" cx="0.42" cy="0.38" r="0.65">
        <stop offset="0" stop-color="#f9a23c"/>
        <stop offset="0.6" stop-color="#f47d2b"/>
        <stop offset="1" stop-color="#e85a25"/>

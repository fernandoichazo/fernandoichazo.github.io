---
// Intro (~2.4s): el antebrazo con el Pip-Boy sube, la muñeca hace el gesto de encendido,
// la pantalla se enciende y la cámara se acerca hasta que solo queda el marco.
// Solo corre cuando TerminalLayout marca data-boot="run" (primera visita de la sesión,
// sin reducción de movimiento). Se omite con clic, espacio, Enter o Esc.
import PipBoyScene from '@components/pipboy/PipBoyScene.astro';
---

<div class="intro" aria-hidden="true">
  <div class="intro__camera">
    <PipBoyScene />
  </div>
  <span class="intro__target"></span>
  <p class="intro__skip">[ESPACIO] O CLIC PARA OMITIR</p>
</div>

<style>
  .intro {
    display: none;
  }

  :global(:root[data-boot='run']) .intro {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: block;
    overflow: hidden;
    background: var(--void);
    cursor: pointer;
    /* Salida de seguridad si el script no llega a ejecutarse. */
    animation: intro-failsafe 0s linear 4s forwards;
  }
  :global(:root[data-boot='run']) .intro.is-done,
  :global(:root[data-boot='skip']) .intro {
    display: none;
  }

  .intro__camera {
    position: absolute;
    inset: 0;
    transform-origin: 0 0;
  }
  .intro__camera :global(.pb-scene) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Estados de partida de la escena (el timeline los lleva a reposo). */
  .intro :global(.pb-rig) {
    transform-box: view-box;
    transform-origin: 800px 500px;
    transform: translate(0, 320px) rotate(-8deg);
  }
  .intro :global(.pb-hand) {
    transform-box: view-box;
    transform-origin: 1290px 540px;
  }
  .intro :global(.pb-led),
  .intro :global(.pb-beam),
  .intro :global(.pb-glow) {
    opacity: 0;
  }
  .intro :global(.pb-beam) {
    transform-box: fill-box;
    transform-origin: center;
  }
  .intro :global(.pb-spill) {
    opacity: 0.25;
  }

  /* Ventana final del marco: el acercamiento encaja la pantalla aquí. */
  .intro__target {
    position: fixed;
    inset: var(--win-top) var(--win-right) var(--win-bottom) var(--win-left);
    pointer-events: none;
  }

  .intro__skip {
    position: absolute;
    left: var(--gutter);
    bottom: 1.5rem;
    font-size: var(--step--1);
    color: var(--phosphor-soft);
  }

  /* Misma condición que el marco girado: el antebrazo sube en vertical, con la pantalla de pie. */
  @media (max-width: 720px) {
    .intro__camera :global(.pb-scene) {
      inset: auto;
      left: 50%;
      top: 50%;
      width: 100vh;
      height: 100vw;
      transform: translate(-50%, -50%) rotate(-90deg);
    }
  }

  @keyframes intro-failsafe {
    to {
      visibility: hidden;
      pointer-events: none;
    }
  }
</style>

<script>
  import { beep } from '@lib/terminal';

  const root = document.documentElement;
  const intro = document.querySelector<HTMLElement>('.intro');

  if (root.dataset.boot === 'run' && intro) {
    const pick = <T extends Element>(selector: string) => intro.querySelector<T>(selector)!;
    const camera = pick<HTMLElement>('.intro__camera');
    const glass = pick<SVGElement>('.pb-glass');
    const target = pick<HTMLElement>('.intro__target');
    const running: Animation[] = [];
    const timers: number[] = [];
    let finished = false;

    const play = (el: Element, frames: Keyframe[], options: KeyframeAnimationOptions) => {
      running.push(el.animate(frames, { fill: 'both', ...options }));
    };
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));

    // Final natural: data-boot sigue en "run" para que el terminal termine de imprimirse.
    // Omitir: data-boot pasa a "skip" y todo aparece de inmediato.
    const finish = (skipped: boolean) => {
      if (finished) return;
      finished = true;
      timers.forEach(clearTimeout);
      running.forEach((animation) => animation.cancel());
      intro.classList.add('is-done');
      if (skipped) root.dataset.boot = 'skip';
      try {
        sessionStorage.setItem('pipos:booted', '1');
      } catch {
        // Sin almacenamiento: la intro se repetirá en la próxima carga.
      }
      document.dispatchEvent(new CustomEvent('pipos:boot-done', { detail: { skipped } }));
      window.removeEventListener('keydown', onKey, true);
    };

    function onKey(event: KeyboardEvent) {
      if ([' ', 'Enter', 'Escape'].includes(event.key)) {
        event.preventDefault();
        event.stopPropagation();
        finish(true);
      }
    }

    // 0–0.7s: el antebrazo sube y gira hasta quedar de frente.
    play(pick('.pb-rig'), [{ transform: 'translate(0, 320px) rotate(-8deg)' }, { transform: 'none' }], {
      duration: 700,
      easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
    });
    // 0.68–1.06s: giro seco de muñeca.
    play(pick('.pb-hand'), [{ transform: 'none' }, { transform: 'rotate(-20deg)', offset: 0.45 }, { transform: 'none' }], {
      duration: 380,
      delay: 680,
      easing: 'ease-in-out',
    });
    // 0.86s: LED; 0.9s: línea de fósforo; 1.1s: la pantalla se ilumina.
    play(pick('.pb-led'), [{ opacity: 0 }, { opacity: 1 }], { duration: 60, delay: 860 });
    play(
      pick('.pb-beam'),
      [
        { opacity: 0, transform: 'scaleX(0)' },
        { opacity: 1, transform: 'scaleX(1)', offset: 0.4 },
        { opacity: 0, transform: 'scaleX(1) scaleY(30)' },
      ],
      { duration: 450, delay: 900, easing: 'ease-out' },
    );
    play(pick('.pb-glow'), [{ opacity: 0 }, { opacity: 1 }], { duration: 350, delay: 1100 });
    play(pick('.pb-spill'), [{ opacity: 0.25 }, { opacity: 1 }], { duration: 400, delay: 900 });
    at(860, () => beep(660, 0.12));

    // 1.3–2.3s: la cámara se acerca hasta encajar la pantalla en la ventana del marco.
    at(1300, () => {
      const from = glass.getBoundingClientRect();
      const to = target.getBoundingClientRect();
      const scale = Math.max(to.width / from.width, to.height / from.height);
      const x = to.left + to.width / 2 - (from.left + from.width / 2) * scale;
      const y = to.top + to.height / 2 - (from.top + from.height / 2) * scale;
      play(camera, [{ transform: 'none' }, { transform: `translate(${x}px, ${y}px) scale(${scale})` }], {
        duration: 1000,
        easing: 'cubic-bezier(0.65, 0, 0.35, 1)',
      });
    });
    // 2.15–2.4s: fundido al marco fijo.
    play(intro, [{ opacity: 1 }, { opacity: 0 }], { duration: 250, delay: 2150 });
    at(2400, () => finish(false));

    intro.addEventListener('click', () => finish(true));
    window.addEventListener('keydown', onKey, true);
  }
</script>

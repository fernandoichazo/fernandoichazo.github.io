---
// Escena de la intro: antebrazo con el Pip-Boy 3000 (ilustración original) y mano enguantada.
// Las clases pb-* son los puntos de animación que usa PipBoyIntro.
---

<svg class="pb-scene" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="pb-casing" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#6e6c4b"/>
      <stop offset="0.18" stop-color="#55553b"/>
      <stop offset="0.75" stop-color="#3f402c"/>
      <stop offset="1" stop-color="#2a2b1d"/>
    </linearGradient>
    <linearGradient id="pb-casing-side" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#2a2b1d"/>
      <stop offset="0.5" stop-color="#46472f"/>
      <stop offset="1" stop-color="#2a2b1d"/>
    </linearGradient>
    <linearGradient id="pb-recess" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1c1d14"/>
      <stop offset="1" stop-color="#34352a"/>
    </linearGradient>
    <radialGradient id="pb-glass" cx="0.5" cy="0.48" r="0.62">
      <stop offset="0" stop-color="#0f2416"/>
      <stop offset="0.6" stop-color="#08130c"/>
      <stop offset="1" stop-color="#020503"/>
    </radialGradient>
    <radialGradient id="pb-glass-on" cx="0.5" cy="0.48" r="0.62">
      <stop offset="0" stop-color="#1bff80" stop-opacity="0.55"/>
      <stop offset="0.55" stop-color="#0f7740" stop-opacity="0.35"/>
      <stop offset="1" stop-color="#020503" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="pb-knob-cap" cx="0.38" cy="0.32" r="0.8">
      <stop offset="0" stop-color="#8c8a66"/>
      <stop offset="0.5" stop-color="#5b5a40"/>
      <stop offset="1" stop-color="#2e2f21"/>
    </radialGradient>
    <linearGradient id="pb-sleeve" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2c4a7e"/>
      <stop offset="0.55" stop-color="#1d335a"/>
      <stop offset="1" stop-color="#101d36"/>
    </linearGradient>
    <linearGradient id="pb-glove" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4a3c30"/>
      <stop offset="0.5" stop-color="#231b15"/>
      <stop offset="1" stop-color="#140f0b"/>
    </linearGradient>
    <radialGradient id="pb-spill" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#1bff80" stop-opacity="0.22"/>
      <stop offset="1" stop-color="#1bff80" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="pb-beam" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1bff80" stop-opacity="0"/>
      <stop offset="0.5" stop-color="#1bff80"/>
      <stop offset="1" stop-color="#1bff80" stop-opacity="0"/>
    </linearGradient>
  </defs>

  <g transform="translate(-60 0)">
  <!-- Luz de la pantalla derramada sobre la escena -->
  <ellipse class="pb-spill" cx="700" cy="460" rx="620" ry="420" fill="url(#pb-spill)"/>

  <g class="pb-rig">
  <!-- Brazo izquierdo: manga del traje de refugio -->
  <g>
    <path d="M-120 380 C 80 372, 260 388, 420 404 L 420 676 C 260 690, 80 712, -120 726 Z" fill="url(#pb-sleeve)"/>
    <path d="M-120 412 C 80 404, 250 416, 410 430" fill="none" stroke="#4a6fae" stroke-width="3" opacity="0.6"/>
    <path d="M40 470 C 120 520, 140 600, 120 690" fill="none" stroke="#0c162b" stroke-width="5" opacity="0.7"/>
    <path d="M220 450 C 280 500, 300 590, 280 680" fill="none" stroke="#0c162b" stroke-width="4" opacity="0.55"/>
    <!-- Puño amarillo -->
    <path d="M330 398 L 400 402 L 400 680 L 330 686 Z" fill="#c99a2e"/>
    <path d="M330 398 L 400 402 L 400 420 L 330 418 Z" fill="#e8bd4f"/>
  </g>

  <!-- Mano izquierda enguantada: puño visto desde el dorso, nudillos hacia la derecha -->
  <g class="pb-hand">
    <path d="M1290 410 L 1350 396 L 1352 668 L 1290 676 Z" fill="#1b140f"/>
    <path d="M1340 394 C 1400 376, 1450 372, 1490 380 L 1500 668 L 1342 672 Z" fill="url(#pb-glove)"/>
    <g class="pb-fingers">
      <path d="M1470 386 C 1500 372, 1546 374, 1566 392 C 1584 408, 1584 446, 1566 458 L 1476 458 Z" fill="#2c221a"/>
      <path d="M1474 458 C 1510 450, 1556 452, 1574 470 C 1590 486, 1588 520, 1570 532 L 1478 532 Z" fill="#271e17"/>
      <path d="M1478 532 C 1512 524, 1554 526, 1570 544 C 1584 560, 1580 592, 1564 602 L 1480 602 Z" fill="#221a14"/>
      <path d="M1480 602 C 1508 596, 1542 598, 1554 614 C 1564 628, 1558 654, 1540 662 L 1486 666 Z" fill="#1d1611"/>
      <g fill="none" stroke="#0d0907" stroke-width="5">
        <path d="M1476 458 H 1572"/><path d="M1478 532 H 1574"/><path d="M1480 602 H 1566"/>
      </g>
      <g fill="none" stroke="#4f9a68" stroke-width="3" opacity="0.75">
        <path d="M1500 378 C 1536 372, 1562 384, 1574 404"/>
        <path d="M1510 456 C 1546 452, 1570 462, 1582 480"/>
        <path d="M1512 530 C 1544 526, 1566 536, 1576 552"/>
      </g>
    </g>
    <path d="M1372 404 C 1410 382, 1470 380, 1520 392 C 1548 398, 1560 416, 1546 428 C 1528 442, 1470 438, 1420 436 C 1396 434, 1376 424, 1372 404 Z" fill="#33281f"/>
    <path d="M1392 400 C 1440 384, 1496 386, 1532 398" fill="none" stroke="#5aa874" stroke-width="3" opacity="0.8"/>
    <path d="M1342 396 C 1400 378, 1446 374, 1480 380" fill="none" stroke="#3fae6c" stroke-width="4" opacity="0.8"/>
    <path d="M1292 412 L 1350 398" stroke="#3fae6c" stroke-width="3" opacity="0.6"/>
  </g>

  <!-- Pip-Boy 3000 (dibujo original) -->
  <g transform="translate(380 190)">
    <!-- Abrazaderas laterales donde pasa el brazo -->
    <rect x="-34" y="150" width="70" height="320" rx="22" fill="url(#pb-casing-side)"/>
    <rect x="864" y="150" width="70" height="320" rx="22" fill="url(#pb-casing-side)"/>
    <!-- Contador Geiger sobre la carcasa -->
    <rect x="230" y="-34" width="320" height="52" rx="26" fill="#4d4d35"/>
    <path d="M262 -30 v44 M294 -30 v44 M326 -30 v44 M358 -30 v44 M390 -30 v44 M422 -30 v44 M454 -30 v44 M486 -30 v44 M518 -30 v44" stroke="#2a2b1d" stroke-width="5"/>
    <rect x="230" y="-34" width="320" height="12" rx="6" fill="#77754f" opacity="0.6"/>
    <!-- Cuerpo -->
    <rect x="0" y="0" width="900" height="600" rx="72" fill="url(#pb-casing)"/>
    <rect x="0" y="0" width="900" height="600" rx="72" fill="none" stroke="#8c8a66" stroke-width="4" opacity="0.55"/>
    <path d="M72 6 H 828" stroke="#a3a07a" stroke-width="5" opacity="0.5"/>
    <!-- Luz de encendido -->
    <circle cx="112" cy="52" r="16" fill="#1c1d14"/>
    <circle cx="112" cy="52" r="10" fill="#28331f"/>
    <circle class="pb-led" cx="112" cy="52" r="10" fill="#1bff80"/>
    <!-- Bisel de la pantalla -->
    <rect x="58" y="92" width="534" height="404" rx="40" fill="url(#pb-recess)"/>
    <rect x="80" y="114" width="490" height="360" rx="30" fill="#0d0e0a"/>
    <rect class="pb-glass" x="94" y="128" width="462" height="332" rx="24" fill="url(#pb-glass)"/>
    <rect class="pb-glow" x="94" y="128" width="462" height="332" rx="24" fill="url(#pb-glass-on)"/>
    <rect class="pb-beam" x="94" y="288" width="462" height="12" fill="url(#pb-beam)"/>
    <!-- Tornillos -->
    <g fill="#9a987a" stroke="#2a2b1d" stroke-width="3">
      <circle cx="40" cy="78" r="12"/><circle cx="610" cy="78" r="12"/>
      <circle cx="40" cy="512" r="12"/><circle cx="610" cy="512" r="12"/>
    </g>
    <g stroke="#2a2b1d" stroke-width="4">
      <path d="M32 78 h16 M602 78 h16 M32 512 h16 M602 512 h16"/>
    </g>
    <!-- Botones bajo la pantalla -->
    <g>
      <rect x="110" y="518" width="118" height="46" rx="10" fill="#2a2b1d"/>
      <rect x="110" y="514" width="118" height="40" rx="10" fill="#6a6948"/>
      <rect x="266" y="518" width="118" height="46" rx="10" fill="#2a2b1d"/>
      <rect x="266" y="514" width="118" height="40" rx="10" fill="#6a6948"/>
      <rect x="422" y="518" width="118" height="46" rx="10" fill="#2a2b1d"/>
      <rect x="422" y="514" width="118" height="40" rx="10" fill="#6a6948"/>
    </g>
    <!-- Módulo derecho: perilla de sintonía, rejilla y perilla menor -->
    <circle cx="752" cy="196" r="116" fill="#24251a"/>
    <circle cx="752" cy="196" r="106" fill="none" stroke="#6e6c4b" stroke-width="16" stroke-dasharray="5 7"/>
    <circle cx="752" cy="196" r="86" fill="url(#pb-knob-cap)"/>
    <path d="M752 196 L 752 124" stroke="#d8d4a8" stroke-width="8" stroke-linecap="round"/>
    <g fill="#1c1d14">
      <rect x="664" y="334" width="176" height="12" rx="6"/>
      <rect x="664" y="356" width="176" height="12" rx="6"/>
      <rect x="664" y="378" width="176" height="12" rx="6"/>
    </g>
    <circle cx="752" cy="474" r="58" fill="#24251a"/>
    <circle cx="752" cy="474" r="44" fill="url(#pb-knob-cap)"/>
    <path d="M752 474 L 782 448" stroke="#d8d4a8" stroke-width="6" stroke-linecap="round"/>
    <!-- Placa grabada -->
    <rect x="224" y="572" width="200" height="22" rx="4" fill="#2a2b1d" opacity="0.6"/>
    <text x="324" y="589" text-anchor="middle" font-family="Share Tech Mono, monospace" font-size="16" letter-spacing="3" fill="#9a987a">PIP-BOY 3000</text>
  </g>
  </g>
</g>
</svg>

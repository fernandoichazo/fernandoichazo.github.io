---
// Escena de la intro: antebrazo con el Pip-Boy 3000 y mano enguantada.
// Las clases pb-* son los puntos de animación que usa PipBoyIntro.
import PipBoyDevice from '@components/pipboy/PipBoyDevice.astro';
---

<svg class="pb-scene" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="pb-sleeve" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2c4a7e"/>
      <stop offset="0.55" stop-color="#1d335a"/>
      <stop offset="1" stop-color="#101d36"/>
    </linearGradient>
    <linearGradient id="pb-glove" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4a3c30"/>
      <stop offset="0.5" stop-color="#231b15"/>
      <stop offset="1" stop-color="#140f0b"/>
    </linearGradient>
    <radialGradient id="pb-spill" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#1bff80" stop-opacity="0.22"/>
      <stop offset="1" stop-color="#1bff80" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <g transform="translate(-60 0)">
  <!-- Luz de la pantalla derramada sobre la escena -->
  <ellipse class="pb-spill" cx="880" cy="450" rx="620" ry="420" fill="url(#pb-spill)"/>

  <g class="pb-rig">
  <!-- Brazo izquierdo: manga del traje de refugio -->
  <g>
    <path d="M-120 380 C 80 372, 260 388, 420 404 L 420 676 C 260 690, 80 712, -120 726 Z" fill="url(#pb-sleeve)"/>
    <path d="M-120 412 C 80 404, 250 416, 410 430" fill="none" stroke="#4a6fae" stroke-width="3" opacity="0.6"/>
    <path d="M40 470 C 120 520, 140 600, 120 690" fill="none" stroke="#0c162b" stroke-width="5" opacity="0.7"/>
    <path d="M220 450 C 280 500, 300 590, 280 680" fill="none" stroke="#0c162b" stroke-width="4" opacity="0.55"/>
    <!-- Puño amarillo -->
    <path d="M330 398 L 400 402 L 400 680 L 330 686 Z" fill="#c99a2e"/>
    <path d="M330 398 L 400 402 L 400 420 L 330 418 Z" fill="#e8bd4f"/>
  </g>

  <!-- Mano izquierda enguantada: puño visto desde el dorso, nudillos hacia la derecha -->
  <g class="pb-hand">
    <path d="M1290 410 L 1350 396 L 1352 668 L 1290 676 Z" fill="#1b140f"/>
    <path d="M1340 394 C 1400 376, 1450 372, 1490 380 L 1500 668 L 1342 672 Z" fill="url(#pb-glove)"/>
    <g class="pb-fingers">
      <path d="M1470 386 C 1500 372, 1546 374, 1566 392 C 1584 408, 1584 446, 1566 458 L 1476 458 Z" fill="#2c221a"/>
      <path d="M1474 458 C 1510 450, 1556 452, 1574 470 C 1590 486, 1588 520, 1570 532 L 1478 532 Z" fill="#271e17"/>
      <path d="M1478 532 C 1512 524, 1554 526, 1570 544 C 1584 560, 1580 592, 1564 602 L 1480 602 Z" fill="#221a14"/>
      <path d="M1480 602 C 1508 596, 1542 598, 1554 614 C 1564 628, 1558 654, 1540 662 L 1486 666 Z" fill="#1d1611"/>
      <g fill="none" stroke="#0d0907" stroke-width="5">
        <path d="M1476 458 H 1572"/><path d="M1478 532 H 1574"/><path d="M1480 602 H 1566"/>
      </g>
      <g fill="none" stroke="#4f9a68" stroke-width="3" opacity="0.75">
        <path d="M1500 378 C 1536 372, 1562 384, 1574 404"/>
        <path d="M1510 456 C 1546 452, 1570 462, 1582 480"/>
        <path d="M1512 530 C 1544 526, 1566 536, 1576 552"/>
      </g>
    </g>
    <path d="M1372 404 C 1410 382, 1470 380, 1520 392 C 1548 398, 1560 416, 1546 428 C 1528 442, 1470 438, 1420 436 C 1396 434, 1376 424, 1372 404 Z" fill="#33281f"/>
    <path d="M1392 400 C 1440 384, 1496 386, 1532 398" fill="none" stroke="#5aa874" stroke-width="3" opacity="0.8"/>
    <path d="M1342 396 C 1400 378, 1446 374, 1480 380" fill="none" stroke="#3fae6c" stroke-width="4" opacity="0.8"/>
    <path d="M1292 412 L 1350 398" stroke="#3fae6c" stroke-width="3" opacity="0.6"/>
  </g>

  <!-- Pip-Boy 3000 vectorizado (PipBoyDevice): las abrazaderas cubren el final de la manga y el puño -->
  <PipBoyDevice x={350} y={160} width={960} />
  </g>
</g>
</svg>

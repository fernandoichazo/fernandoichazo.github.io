---
// Pantalla de la directiva [4] ACERCA DE MÍ. La monta src/pages/[lang]/[directiva].astro en cada idioma.
import TerminalLayout from '@layouts/TerminalLayout.astro';
import TerminalHeader from '@components/terminal/TerminalHeader.astro';
import SectionIndex from '@components/terminal/SectionIndex.astro';
import DataSection from '@components/terminal/DataSection.astro';
import BackCommand from '@components/terminal/BackCommand.astro';
import BioIntro from '@components/acerca-de-mi/BioIntro.astro';
import PassionList from '@components/acerca-de-mi/PassionList.astro';
import HobbyInventory from '@components/acerca-de-mi/HobbyInventory.astro';
import AttributeStats from '@components/acerca-de-mi/AttributeStats.astro';
import StatusReadout from '@components/acerca-de-mi/StatusReadout.astro';
import FactList from '@components/acerca-de-mi/FactList.astro';
import ClosingPrompt from '@components/acerca-de-mi/ClosingPrompt.astro';
import { BiografiaService } from '@services/acerca-de-mi';
import { PersonalService } from '@services/perfil';
import { idiomaDe, rutaDe, traducir } from '@i18n';
import type { Directive } from '@data/site';

interface Props {
  directive: Directive;
}

const { directive } = Astro.props;
const idioma = idiomaDe(Astro);
const t = traducir(idioma);
const label = t.directivas[directive.id];

const [personal, biografia, pasiones, tiempoLibre, atributos, actualmente, datosCuriosos] = await Promise.all([
  PersonalService.getPersonal(idioma),
  BiografiaService.getBiografia(idioma),
  BiografiaService.getPasiones(idioma),
  BiografiaService.getTiempoLibre(idioma),
  BiografiaService.getAtributos(idioma),
  BiografiaService.getActualmente(idioma),
  BiografiaService.getDatosCuriosos(idioma),
]);

const titulos = t.acercaDeMi.secciones;
const sections = {
  pasiones: { id: 'pasiones', sectionKey: '1', title: titulos.pasiones, file: 'PASSIONS.DAT' },
  tiempoLibre: { id: 'tiempo-libre', sectionKey: '2', title: titulos.tiempoLibre, file: 'OFF_DUTY.INV' },
  comportamiento: { id: 'comportamiento', sectionKey: '3', title: titulos.comportamiento, file: 'BEHAVIOR_PROTOCOL.SYS' },
  actualmente: { id: 'actualmente', sectionKey: '4', title: titulos.actualmente, file: 'CURRENT_STATUS.LOG' },
  datosCuriosos: { id: 'datos-curiosos', sectionKey: '5', title: titulos.datosCuriosos, file: 'TRIVIA.TXT' },
};
---

<TerminalLayout
  title={`${label} · ${personal.nombreCompleto}`}
  description={`${personal.nombreCompleto}: ${biografia.presentacion}`}
  pagina={directive.id}
  statusMessage={t.estado.modulo(directive.file, Object.keys(sections).length)}
  statusMessageMid={t.estado.moduloMedio(directive.file)}
  statusMessageShort={t.estado.volver}
>
  <TerminalHeader showLog={false} />
  <BioIntro
    file={directive.file}
    nombre={personal.nombreCompleto}
    presentacion={biografia.presentacion}
    directiva={biografia.directiva}
  />
  <SectionIndex entries={Object.values(sections)} />

  <DataSection {...sections.pasiones}>
    <PassionList items={pasiones} />
  </DataSection>

  <DataSection {...sections.tiempoLibre}>
    <HobbyInventory items={tiempoLibre} />
  </DataSection>

  <DataSection {...sections.comportamiento}>
    <AttributeStats items={atributos} />
  </DataSection>

  <DataSection {...sections.actualmente}>
    <StatusReadout items={actualmente} />
  </DataSection>

  <DataSection {...sections.datosCuriosos}>
    <FactList items={datosCuriosos} />
  </DataSection>

  <ClosingPrompt
    mensaje={biografia.cierre}
    proyectosHref={rutaDe(idioma, 'proyectos')}
    linkedin={personal.contacto.linkedin}
  />

  <div class="actions">
    <BackCommand />
  </div>
</TerminalLayout>

<style>
  .actions {
    margin: clamp(2rem, var(--screen-h) * 0.06, 3.5rem) 0;
  }
</style>

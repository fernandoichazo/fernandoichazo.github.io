---
// Cristal del tubo: superficie abombada, viñeta, scanlines y flicker.
// Ocupa la ventana que deja libre el marco del Pip-Boy (tokens --win-*); el contenido
// se desplaza bajo el marco fijo, que recorta las esquinas del tubo.
---

<div class="crt">
  <div class="crt__content">
    <slot />
  </div>
  <div class="crt__layer crt__scanlines" aria-hidden="true"></div>
  <div class="crt__layer crt__flicker" aria-hidden="true"></div>
  <div class="crt__layer crt__vignette" aria-hidden="true"></div>
</div>

<style>
  /* La página no se desplaza: la pantalla es el contenedor de scroll, dentro del cristal. */
  .crt {
    position: relative;
    height: 100dvh;
    overflow: hidden;
    padding: var(--win-top) var(--win-right) var(--win-bottom) var(--win-left);
    background: var(--casing);
  }

  .crt__content {
    position: relative;
    height: var(--screen-h);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--phosphor-dim) transparent;
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, var(--screen-h) * 0.04, 2.75rem) var(--gutter) 0;
    border-radius: var(--tube-radius);
    background: radial-gradient(
      ellipse 80% 75% at 50% 46%,
      var(--surface-lift) 0%,
      var(--surface) 52%,
      var(--void) 100%
    );
    background-attachment: fixed;
  }
  .crt__content > :global(*) {
    flex-shrink: 0;
  }

  .crt__layer {
    position: fixed;
    inset: var(--win-top) var(--win-right) var(--win-bottom) var(--win-left);
    border-radius: var(--tube-radius);
    pointer-events: none;
    z-index: 20;
  }

  /* Elipse con la forma del tubo: oscurece las esquinas, no el borde de la columna. */
  .crt__vignette {
    background: radial-gradient(ellipse farthest-corner, transparent 78%, rgb(0 0 0 / 0.7) 100%);
  }

  .crt__scanlines {
    background: repeating-linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.25) 0 1px,
      transparent 1px 3px
    );
  }

  .crt__flicker {
    background: var(--phosphor);
    opacity: 0;
    animation: flicker 6s steps(1) infinite;
  }

  @keyframes flicker {
    0%, 100% { opacity: 0; }
    12% { opacity: 0.018; }
    13% { opacity: 0; }
    47% { opacity: 0.012; }
    48% { opacity: 0.026; }
    49% { opacity: 0; }
    81% { opacity: 0.015; }
    82% { opacity: 0; }
  }

  :global(:root[data-crt='off']) .crt__scanlines,
  :global(:root[data-crt='off']) .crt__flicker {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .crt__flicker {
      display: none;
    }
  }
</style>

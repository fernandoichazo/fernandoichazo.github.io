---
// Cristal del tubo: superficie abombada, viñeta, scanlines y flicker.
// El contenido se desplaza bajo un marco fijo que recorta las esquinas del tubo.
---

<div class="crt">
  <div class="crt__content">
    <slot />
  </div>
  <div class="crt__layer crt__scanlines" aria-hidden="true"></div>
  <div class="crt__layer crt__flicker" aria-hidden="true"></div>
  <div class="crt__layer crt__vignette" aria-hidden="true"></div>
  <div class="crt__bezel" aria-hidden="true"></div>
</div>

<style>
  .crt {
    --inset: 18px;
    --radius: 34px;
    position: relative;
    min-height: 100dvh;
    padding: var(--inset);
    background: var(--void);
  }

  .crt__content {
    position: relative;
    min-height: calc(100dvh - 2 * var(--inset));
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem) var(--gutter) 0;
    border-radius: var(--radius);
    background: radial-gradient(
      ellipse 80% 75% at 50% 46%,
      var(--surface-lift) 0%,
      var(--surface) 52%,
      var(--void) 100%
    );
    background-attachment: fixed;
  }

  .crt__layer,
  .crt__bezel {
    position: fixed;
    inset: var(--inset);
    border-radius: var(--radius);
    pointer-events: none;
    z-index: 20;
  }

  .crt__vignette {
    background: radial-gradient(circle, transparent 65%, rgb(0 0 0 / 0.85) 100%);
  }

  .crt__scanlines {
    background: repeating-linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.25) 0 1px,
      transparent 1px 3px
    );
  }

  .crt__flicker {
    background: var(--phosphor);
    opacity: 0;
    animation: flicker 6s steps(1) infinite;
  }

  /* Marco que tapa lo que se desplaza fuera del cristal redondeado. */
  .crt__bezel {
    box-shadow: 0 0 0 100vmax var(--void);
    z-index: 21;
  }

  @keyframes flicker {
    0%, 100% { opacity: 0; }
    12% { opacity: 0.018; }
    13% { opacity: 0; }
    47% { opacity: 0.012; }
    48% { opacity: 0.026; }
    49% { opacity: 0; }
    81% { opacity: 0.015; }
    82% { opacity: 0; }
  }

  :global(:root[data-crt='off']) .crt__scanlines,
  :global(:root[data-crt='off']) .crt__flicker {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .crt__flicker {
      display: none;
    }
  }

  /* Móvil: pantalla vertical de Pip-Boy dentro de su carcasa. */
  @media (max-width: 720px) {
    .crt {
      --inset: 10px;
      --radius: 22px;
      padding-top: 34px;
      background: #121810;
    }
    .crt__content {
      min-height: calc(100dvh - 34px - var(--inset));
    }
    .crt__layer,
    .crt__bezel {
      top: 34px;
    }
    .crt__bezel {
      box-shadow: 0 0 0 100vmax #121810;
    }
    .crt::before {
      content: 'ROBCO IND. · PIP-BOY 3000';
      position: fixed;
      top: 9px;
      left: 0;
      right: 0;
      z-index: 22;
      text-align: center;
      font-size: 0.75rem;
      letter-spacing: 0.3em;
      color: #7d8f73;
      text-shadow: none;
    }
  }
</style>

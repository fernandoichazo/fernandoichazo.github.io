---
// Entrada de log para experiencia y formación: periodo, título @ entidad, descripción y etiquetas.
interface Props {
  period: string;
  title: string;
  entity: string;
  location: string;
  current?: boolean;
  currentLabel?: string;
  description?: string;
  tags?: string[];
}

const { period, title, entity, location, current = false, currentLabel = 'EN CURSO', description, tags = [] } =
  Astro.props;
---

<article class="entry">
  <p class="period">
    [{period}]
    {current && <span class="current">{currentLabel}</span>}
  </p>
  <h3 class="title">{title}</h3>
  <p class="entity"><span aria-hidden="true">@ </span>{entity} <span class="location"><span aria-hidden="true">// </span>{location}</span></p>
  {description && <p class="description">{description}</p>}
  {
    tags.length > 0 && (
      <ul class="tags" aria-label="Tecnologías">
        {tags.map((tag) => (
          <li>[{tag}]</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .entry {
    position: relative;
    padding: 0 0 1.5rem 1.5rem;
    border-left: 2px solid var(--phosphor-dim);
  }
  .entry:last-child {
    padding-bottom: 0.25rem;
  }
  /* Nodo del log sobre el riel. */
  .entry::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 0.45em;
    width: 10px;
    height: 10px;
    background: var(--phosphor);
    box-shadow: var(--glow);
  }

  .period {
    font-size: var(--step--1);
    color: var(--phosphor-soft);
  }
  .current {
    margin-left: 0.75em;
    color: var(--warning);
    text-shadow: 0 0 6px var(--warning-glow);
  }
  :global(:root[data-crt='off']) .current {
    text-shadow: none;
  }

  .title {
    margin-top: 0.15rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.15;
  }
  .entity {
    margin-top: 0.15rem;
  }
  .location {
    color: var(--phosphor-soft);
  }

  .description {
    max-width: 68ch;
    margin-top: 0.5rem;
    line-height: 1.6;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1em;
    margin-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--phosphor-soft);
  }
</style>

---
// Retrato del sujeto. Sin foto en personal.json muestra una silueta pixelada de fósforo.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  foto: ImageMetadata | null;
  alt: string;
}

const { foto, alt } = Astro.props;
---

<figure class="portrait">
  <div class="frame">
    {
      foto ? (
        <Image src={foto} alt={alt} widths={[192, 384]} sizes="12rem" class="photo" />
      ) : (
        <svg class="silhouette" viewBox="0 0 16 16" role="img" aria-label="Sin foto de perfil" shape-rendering="crispEdges">
          <rect x="6" y="2" width="4" height="1" />
          <rect x="5" y="3" width="6" height="4" />
          <rect x="6" y="7" width="4" height="1" />
          <rect x="7" y="8" width="2" height="1" />
          <rect x="4" y="9" width="8" height="1" />
          <rect x="3" y="10" width="10" height="6" />
        </svg>
      )
    }
  </div>
  <figcaption class="caption">
    <span class="line">IMG_SUJETO.RAW</span>
    {!foto && <span class="line">SIN SEÑAL</span>}
  </figcaption>
</figure>

<style>
  .portrait {
    width: clamp(8rem, 6rem + 6vw, 12rem);
  }

  .frame {
    position: relative;
    aspect-ratio: 1;
    padding: 0.5rem;
    border: 2px solid var(--phosphor-dim);
    background: var(--surface-lift);
  }

  .silhouette {
    display: block;
    width: 100%;
    height: 100%;
    fill: var(--phosphor-soft);
    filter: drop-shadow(0 0 6px var(--phosphor-glow));
  }
  :global(:root[data-crt='off']) .silhouette {
    filter: none;
  }

  .photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) sepia(1) hue-rotate(80deg) saturate(2.5) brightness(0.9);
  }

  .line {
    display: block;
  }
  .caption {
    margin-top: 0.4rem;
    font-size: var(--step--1);
    color: var(--phosphor-soft);
  }
</style>

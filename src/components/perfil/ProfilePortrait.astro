---
// Retrato del sujeto. Sin foto en personal.json muestra una silueta pixelada de fósforo.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PhosphorImage from '@components/crt/PhosphorImage.astro';
import { idiomaDe, traducir } from '@i18n';

interface Props {
  foto: ImageMetadata | null;
  alt: string;
}

const { foto, alt } = Astro.props;
const t = traducir(idiomaDe(Astro)).perfil;
---

<figure class="portrait">
  <div class="frame">
    {
      foto ? (
        <PhosphorImage class="screen">
          <Image src={foto} alt={alt} widths={[288, 576]} sizes="18rem" class="photo" />
        </PhosphorImage>
      ) : (
        <svg class="silhouette" viewBox="0 0 16 16" role="img" aria-label={t.sinFoto} shape-rendering="crispEdges">
          <rect x="6" y="2" width="4" height="1" />
          <rect x="5" y="3" width="6" height="4" />
          <rect x="6" y="7" width="4" height="1" />
          <rect x="7" y="8" width="2" height="1" />
          <rect x="4" y="9" width="8" height="1" />
          <rect x="3" y="10" width="10" height="6" />
        </svg>
      )
    }
  </div>
  <figcaption class="caption">
    <span class="line">IMG_SUJETO.RAW</span>
    {!foto && <span class="line">{t.sinSenal}</span>}
  </figcaption>
</figure>

<style>
  .portrait {
    /* Escala con el nombre (--step-display) para ocupar la altura del titular y sus datos. */
    width: calc(var(--step-display) * 3);
  }

  .frame {
    position: relative;
    aspect-ratio: 1;
    padding: 0.5rem;
    border: 2px solid var(--phosphor-dim);
    background: var(--surface-lift);
  }

  .silhouette {
    display: block;
    width: 100%;
    height: 100%;
    fill: var(--phosphor-soft);
    filter: drop-shadow(0 0 6px var(--phosphor-glow));
  }
  :global(:root[data-crt='off']) .silhouette {
    filter: none;
  }

  .portrait :global(.screen) {
    width: 100%;
    height: 100%;
  }

  /* La foto se muestra tal cual; el tinte verde lo pone PhosphorImage por encima. */
  .photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .line {
    display: block;
  }
  .caption {
    margin-top: 0.4rem;
    font-size: var(--step--1);
    color: var(--phosphor-soft);
  }
</style>

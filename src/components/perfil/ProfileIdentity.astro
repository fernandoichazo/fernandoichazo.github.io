---
// Ficha de identidad: retrato, nombre, titular, ubicación, enlace y resumen.
import type { ImageMetadata } from 'astro';
import PhosphorText from '@components/crt/PhosphorText.astro';
import ProfilePortrait from '@components/perfil/ProfilePortrait.astro';
import type { Personal } from '@interfaces/perfil';

interface Props {
  personal: Personal;
  foto: ImageMetadata | null;
  file: string;
}

const { personal, foto, file } = Astro.props;
---

<section class="identity" aria-labelledby="profile-name">
  <p class="log">&gt; EJECUTANDO {file}... <span class="ok">[OK]</span></p>
  <div class="dossier">
    <ProfilePortrait foto={foto} alt={`Foto de ${personal.nombreCompleto}`} />
    <div class="data">
      <PhosphorText as="h1" id="profile-name" size="display" glow="strong" class="name">
        {personal.nombreCompleto}
      </PhosphorText>
      <p class="headline">{personal.titular}</p>
      <dl class="fields">
        <div class="field">
          <dt>UBICACIÓN:</dt>
          <dd>{personal.ubicacion.ciudad} <span class="sep" aria-hidden="true">//</span> {personal.ubicacion.pais}</dd>
        </div>
        <div class="field">
          <dt>ENLACE:</dt>
          <dd>
            <a class="link" href={personal.contacto.linkedin} target="_blank" rel="noopener noreferrer">
              <span aria-hidden="true">[&gt;] </span>LINKEDIN <span class="handle">/{personal.contacto.linkedinUsuario}</span>
              <span class="sr-only">(se abre en una pestaña nueva)</span>
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </div>
  <p class="summary">{personal.resumen}</p>
</section>

<style>
  .identity {
    container-type: inline-size;
    margin-top: clamp(1.25rem, var(--screen-h) * 0.04, 2.5rem);
  }

  .log {
    font-size: var(--step--1);
    color: var(--phosphor-soft);
  }
  .ok {
    color: var(--phosphor);
  }

  .dossier {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    width: min(70rem, 100%);
    margin-top: 1rem;
  }

  .data {
    min-width: 0;
  }
  .identity :global(.name) {
    text-wrap: balance;
  }
  .headline {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    letter-spacing: 0.06em;
    line-height: 1.2;
  }

  .fields {
    margin-top: 0.75rem;
    font-size: var(--step-0);
  }
  .field {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.75em;
  }
  dt {
    color: var(--phosphor-soft);
  }
  .sep,
  .handle {
    color: var(--phosphor-soft);
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    margin-left: -0.5rem;
    padding: 0 0.5rem;
  }
  .link:hover {
    background: var(--phosphor);
    color: var(--void);
    text-shadow: none;
  }
  .link:hover .handle {
    color: var(--void);
  }

  .summary {
    max-width: 68ch;
    margin-top: 1.25rem;
    font-size: var(--step-0);
    line-height: 1.6;
  }

  @container (max-width: 34rem) {
    .dossier {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
    .handle {
      display: none;
    }
  }
</style>

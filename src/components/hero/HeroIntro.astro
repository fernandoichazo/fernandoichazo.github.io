---
// Bienvenida con efecto typewriter, nombre, rol y disponibilidad.
// El texto completo está en el HTML; el script solo lo re-escribe tras el arranque.
import PhosphorText from '@components/crt/PhosphorText.astro';
import { profile } from '@data/site';

const rule = '='.repeat(120);
---

<section class="hero" aria-labelledby="welcome">
  <p class="rule reveal" style="--i:4" aria-hidden="true">{rule}</p>
  <PhosphorText as="h1" id="welcome" size="display" glow="strong" class="welcome" data-typewriter>
    BIENVENIDO A MI PORTAFOLIO
  </PhosphorText>
  <p class="who reveal" style="--i:5">
    <span class="seg">{profile.name}</span>
    <span class="seg"><span class="sep" aria-hidden="true">// </span>{profile.role}</span>
    <span class="seg"><span class="sep" aria-hidden="true">// </span>STATUS: {profile.status}</span>
  </p>
  <p class="rule reveal" style="--i:6" aria-hidden="true">{rule}</p>
</section>

<style>
  .hero {
    margin-top: clamp(1rem, var(--screen-h) * 0.03, 3rem);
  }

  .rule {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: 0.2em;
    color: var(--phosphor-dim);
    white-space: nowrap;
    overflow: hidden;
    width: min(70rem, 100%);
    max-width: 100%;
  }

  .welcome {
    position: relative;
    margin: 0.5rem 0 0.25rem;
    text-wrap: balance;
  }

  /* Identidad en una línea; cada "//" va unido a lo que sigue. */
  .who {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.75em;
    font-size: clamp(0.95rem, 0.55rem + 0.6vw, 1.25rem);
    line-height: 1.5;
    margin-bottom: clamp(0.75rem, var(--screen-h) * 0.02, 1.5rem);
  }
  .seg {
    white-space: nowrap;
  }
  .sep {
    color: var(--phosphor-soft);
  }

  /* Cursor del typewriter: bloque propio, movido con transform (sin CLS). */
  .welcome :global(.tw-caret) {
    position: absolute;
    left: 0;
    top: 0;
    width: 0.5em;
    height: 0.8em;
    background: var(--phosphor);
    box-shadow: var(--glow);
  }
  :global(:root[data-boot='run']) .welcome :global(.tw:not(.is-on)) {
    visibility: hidden;
  }

  @media (max-width: 640px) {
    .who {
      flex-direction: column;
    }
    .seg {
      white-space: normal;
    }
    .sep {
      display: none;
    }
  }
</style>

<script>
  import { prefersReducedMotion } from '@lib/terminal';

  const root = document.documentElement;
  const heading = document.querySelector<HTMLElement>('[data-typewriter]');

  if (heading && root.dataset.boot === 'run' && !prefersReducedMotion()) {
    const text = heading.textContent?.trim() ?? '';
    const accessible = document.createElement('span');
    accessible.className = 'sr-only';
    accessible.textContent = text;
    const visual = document.createElement('span');
    visual.setAttribute('aria-hidden', 'true');
    const chars = [...text].map((char) => {
      const span = document.createElement('span');
      span.className = 'tw';
      span.textContent = char;
      visual.append(span);
      return span;
    });
    heading.replaceChildren(accessible, visual);

    const revealAll = () => chars.forEach((span) => span.classList.add('is-on'));

    document.addEventListener(
      'pipos:boot-done',
      (event) => {
        if ((event as CustomEvent).detail?.skipped) return revealAll();
        const caret = document.createElement('span');
        caret.className = 'tw-caret';
        caret.setAttribute('aria-hidden', 'true');
        heading.append(caret);
        const lineOffset = (span: HTMLElement) => span.offsetHeight * 0.1;

        let i = 0;
        const tick = () => {
          if (i >= chars.length) return caret.remove();
          const span = chars[i];
          span.classList.add('is-on');
          const x = span.offsetLeft + span.offsetWidth;
          const y = span.offsetTop + lineOffset(span);
          caret.style.transform = `translate(${x}px, ${y}px)`;
          i += 1;
          window.setTimeout(tick, 32);
        };
        tick();
      },
      { once: true },
    );
  }
</script>

---
// Capturas de un proyecto con filtro de fósforo. Cada una abre la imagen original en otra pestaña.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PhosphorImage from '@components/crt/PhosphorImage.astro';
import { idiomaDe, traducir } from '@i18n';

interface Props {
  imagenes: ImageMetadata[];
  nombre: string;
}

const { imagenes, nombre } = Astro.props;
const t = traducir(idiomaDe(Astro));
const d = t.proyectos.detalle;
---

<ul class="gallery">
  {
    imagenes.map((imagen, index) => {
      const alt = d.captura(nombre, index + 1);
      return (
        <li>
          <a class="shot-link" href={imagen.src} target="_blank" rel="noopener">
            <PhosphorImage class="frame">
              <Image src={imagen} alt={alt} widths={[480, 960]} sizes="(max-width: 48rem) 100vw, 30rem" class="shot" />
            </PhosphorImage>
            <span class="sr-only">{t.comun.pestanaNueva}</span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
  }
  .shot-link {
    display: block;
  }
  .shot-link:focus-visible {
    outline: 2px solid var(--phosphor);
    outline-offset: 3px;
  }
  .gallery :global(.frame) {
    aspect-ratio: 16 / 10;
  }
  .shot {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

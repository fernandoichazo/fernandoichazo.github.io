---
// Cierre de MIS PROYECTOS: invita a contactar por LinkedIn o a ver el perfil.
import { idiomaDe, rutaDe, traducir } from '@i18n';

interface Props {
  linkedin: string;
}

const { linkedin } = Astro.props;
const idioma = idiomaDe(Astro);
const t = traducir(idioma);
const c = t.proyectos.cierre;
---

<section class="closing" aria-labelledby="projects-closing-title">
  <p class="rule" aria-hidden="true">{'='.repeat(240)}</p>
  <h2 id="projects-closing-title" class="message">&gt; {c.mensaje}</h2>
  <ul class="options">
    <li>
      <a class="option" href={linkedin} target="_blank" rel="noopener noreferrer">
        <span class="key">[&gt;]</span> {c.transmision}
        <span class="sr-only">{t.comun.pestanaNueva}</span>
      </a>
    </li>
    <li>
      <a class="option" href={rutaDe(idioma, 'perfil')}><span class="key">[&gt;]</span> {c.perfil}</a>
    </li>
  </ul>
</section>

<style>
  .closing {
    margin-top: clamp(1.75rem, var(--screen-h) * 0.05, 3rem);
    width: 100%;
  }
  .rule {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: 0.2em;
    color: var(--phosphor-dim);
    white-space: nowrap;
    overflow: hidden;
  }
  .message {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-wrap: balance;
  }
  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.5rem;
    margin-left: -0.5rem;
  }
  .option {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    padding: 0 0.5rem;
  }
  .key {
    color: var(--phosphor-soft);
  }
  .option:hover,
  .option:focus-visible {
    background: var(--phosphor);
    color: var(--void);
    text-shadow: none;
  }
  .option:hover .key,
  .option:focus-visible .key {
    color: var(--void);
  }
</style>

---
// Una credencial (certificación, competencia o idioma): fecha, estado, emisor, resultado,
// ID, vencimiento, habilidades que respalda y enlace de verificación.
import type { CredencialDetalle } from '@interfaces/certificaciones';
import { formatearFecha } from '@lib/fechas';
import { idiomaDe, traducir } from '@i18n';

interface Props {
  item: CredencialDetalle;
}

const { item } = Astro.props;
const idioma = idiomaDe(Astro);
const t = traducir(idioma);
const c = t.certificaciones;

const fecha = item.emision ? formatearFecha(item.emision, idioma) : c.sinFecha;
const vencimiento = item.expiracion
  ? `${item.estado === 'expirada' ? c.expiro : c.expira}: ${formatearFecha(item.expiracion, idioma)}`
  : null;
// En competencias "sin enlace" no aporta: solo se marca si hay algo que verificar.
const mostrarEstado = !(item.categoria === 'competencia' && item.estado === 'sin-enlace');
const meta = [item.credencialId && `${c.credencialId}: ${item.credencialId}`, vencimiento].filter(Boolean);
---

<article class:list={['entry', `is-${item.estado}`]}>
  <p class="head">
    <span class="date">[{fecha}]</span>
    {mostrarEstado && <span class="status">[{c.estados[item.estado]}]</span>}
    {item.destacado && <span class="featured">★ {c.destacada}</span>}
  </p>
  <h3 class="title">{item.titulo}</h3>
  <p class="issuer"><span aria-hidden="true">@ </span>{item.emisor}</p>

  {
    item.resultado && (
      <p class="result">
        <span class="label">{c.resultado}:</span> {item.resultado}
      </p>
    )
  }
  {meta.length > 0 && <p class="meta">{meta.join(' · ')}</p>}

  {
    item.nombresHabilidades.length > 0 && (
      <ul class="tags" aria-label={c.habilidades}>
        {item.nombresHabilidades.map((nombre) => (
          <li>[{nombre}]</li>
        ))}
      </ul>
    )
  }

  {
    item.url && (
      <a class="verify" href={item.url} target="_blank" rel="noopener noreferrer">
        {c.verificar}
        <span class="sr-only">
          {' '}
          {item.titulo} {t.comun.pestanaNueva}
        </span>
      </a>
    )
  }
</article>

<style>
  .entry {
    position: relative;
    padding: 0 0 1.5rem 1.5rem;
    border-left: 2px solid var(--phosphor-dim);
  }
  .entry:last-child {
    padding-bottom: 0.25rem;
  }
  .entry::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 0.45em;
    width: 10px;
    height: 10px;
    background: var(--phosphor);
    box-shadow: var(--glow);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75em;
    font-size: var(--step--1);
    color: var(--phosphor-soft);
  }
  .status {
    color: var(--phosphor);
  }
  .is-expirada .status,
  .is-sin-enlace .status {
    color: var(--phosphor-soft);
  }
  .featured {
    color: var(--warning);
    text-shadow: 0 0 6px var(--warning-glow);
  }
  :global(:root[data-crt='off']) .featured {
    text-shadow: none;
  }

  .title {
    margin-top: 0.15rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.15;
  }
  .is-expirada .title {
    text-decoration: line-through;
    text-decoration-color: var(--phosphor-dim);
  }
  .issuer {
    margin-top: 0.15rem;
    color: var(--phosphor-soft);
  }

  .result {
    margin-top: 0.5rem;
  }
  .label {
    color: var(--phosphor-soft);
  }
  .meta {
    margin-top: 0.35rem;
    font-size: var(--step--1);
    color: var(--phosphor-soft);
    overflow-wrap: anywhere;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1em;
    margin-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--phosphor-soft);
  }

  .verify {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-left: -0.5rem;
    padding: 0 0.5rem;
    font-size: var(--step--1);
  }
  .verify:hover {
    background: var(--phosphor);
    color: var(--void);
    text-shadow: none;
  }
</style>

---
// Cursos y formación complementaria: lista compacta con año, título, emisor, horas y enlace.
import type { CredencialDetalle } from '@interfaces/certificaciones';
import { idiomaDe, traducir } from '@i18n';

interface Props {
  items: CredencialDetalle[];
}

const { items } = Astro.props;
const t = traducir(idiomaDe(Astro));
const c = t.certificaciones;
---

<div class="wrap">
  <ul class="list">
    {
      items.map((item) => (
        <li class="row">
          <span class="year">[{item.emision?.slice(0, 4) ?? c.sinFecha}]</span>
          <span class="info">
            <span class="title">{item.titulo}</span>
            <span class="type">
              {item.emisor}
              {item.horas !== null && ` · ${c.horas(item.horas)}`}
            </span>
          </span>
          {item.url && (
            <a class="verify" href={item.url} target="_blank" rel="noopener noreferrer">
              {c.verificar}
              <span class="sr-only">
                {' '}
                {item.titulo} {t.comun.pestanaNueva}
              </span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .wrap {
    container-type: inline-size;
  }
  .row {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.5rem;
  }
  .year {
    color: var(--phosphor-soft);
  }
  .info {
    display: flex;
    flex-direction: column;
  }
  .type {
    font-size: var(--step--1);
    color: var(--phosphor-soft);
  }
  .verify {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.5rem;
    font-size: var(--step--1);
  }
  .verify:hover {
    background: var(--phosphor);
    color: var(--void);
    text-shadow: none;
  }

  @container (max-width: 34rem) {
    .row {
      grid-template-columns: 4.5rem 1fr;
    }
    .verify {
      grid-column: 2;
      justify-self: start;
      margin-left: -0.5rem;
    }
  }
</style>

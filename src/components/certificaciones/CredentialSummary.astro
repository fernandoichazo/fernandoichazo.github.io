---
// Cabecera de MIS CERTIFICACIONES: título, introducción y contadores de credenciales.
import PhosphorText from '@components/crt/PhosphorText.astro';
import type { ResumenCredenciales } from '@interfaces/certificaciones';
import { formatearFecha } from '@lib/fechas';
import { idiomaDe, traducir } from '@i18n';

interface Props {
  file: string;
  resumen: ResumenCredenciales;
}

const { file, resumen } = Astro.props;
const idioma = idiomaDe(Astro);
const t = traducir(idioma);
const r = t.certificaciones.resumen;

const contadores = [
  { etiqueta: r.credenciales, valor: String(resumen.credenciales) },
  { etiqueta: r.verificadas, valor: String(resumen.verificadas) },
  { etiqueta: r.competencias, valor: String(resumen.competencias) },
  { etiqueta: r.cursos, valor: `${resumen.cursos} · ${r.horas(resumen.horasCursos)}` },
  { etiqueta: r.enProgreso, valor: String(resumen.enProgreso) },
  {
    etiqueta: r.ultima,
    valor: resumen.ultima ? formatearFecha(resumen.ultima, idioma) : t.certificaciones.sinFecha,
  },
];
---

<section class="intro" aria-labelledby="creds-title">
  <p class="log">&gt; {t.comun.cargando} {file}... <span class="ok">[OK]</span></p>
  <PhosphorText as="h1" id="creds-title" size="display" glow="strong" class="title">
    {t.certificaciones.titulo}
  </PhosphorText>
  <p class="lead">{t.certificaciones.intro}</p>

  <dl class="counters" aria-label={r.etiqueta}>
    {
      contadores.map((item) => (
        <div class="counter">
          <dt class="label">{item.etiqueta}</dt>
          <dd class="value">{item.valor}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .intro {
    margin-top: clamp(1.25rem, var(--screen-h) * 0.04, 2.5rem);
    width: 100%;
    container-type: inline-size;
  }
  .log {
    font-size: var(--step--1);
    color: var(--phosphor-soft);
  }
  .ok {
    color: var(--phosphor);
  }
  .intro :global(.title) {
    margin-top: 0.75rem;
  }
  .lead {
    margin-top: 1rem;
    line-height: 1.6;
    max-width: 70ch;
  }

  .counters {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 1.75rem;
    border: 2px solid var(--phosphor-dim);
    background: var(--phosphor-dim);
  }
  .counter {
    padding: 0.75rem 1rem;
    background: var(--surface-lift);
  }
  .label {
    font-size: var(--step--1);
    color: var(--phosphor-soft);
  }
  .value {
    margin-top: 0.15rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    letter-spacing: 0.06em;
    line-height: 1.15;
  }

  @container (max-width: 34rem) {
    .counters {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

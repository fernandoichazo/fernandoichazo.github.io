---
import TerminalLayout from '@layouts/TerminalLayout.astro';
import TerminalHeader from '@components/terminal/TerminalHeader.astro';
import ModulePending from '@components/terminal/ModulePending.astro';
import { directives, profile, type Directive } from '@data/site';

export function getStaticPaths() {
  return directives.map((directive) => ({
    params: { directiva: directive.slug },
    props: { directive },
  }));
}

const { directive } = Astro.props as { directive: Directive };
---

<TerminalLayout
  title={`${directive.label} · ${profile.name}`}
  description={`${directive.label}: sección del portafolio de ${profile.name}.`}
  statusMessage={`${directive.file} · PULSA [ESC] PARA VOLVER`}
  statusMessageMid={`${directive.file} · [ESC] VOLVER`}
  statusMessageShort="[ESC] VOLVER"
>
  <TerminalHeader showLog={false} />
  <ModulePending directive={directive} />
</TerminalLayout>

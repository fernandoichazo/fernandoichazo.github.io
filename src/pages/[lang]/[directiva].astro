---
// Las 4 directivas en cada idioma, con su slug traducido (/es/perfil, /en/profile...).
// Cada directiva con contenido propio tiene su pantalla; el resto muestra "módulo en preparación".
import ProfileScreen from '@components/perfil/ProfileScreen.astro';
import AboutScreen from '@components/acerca-de-mi/AboutScreen.astro';
import CertificationsScreen from '@components/certificaciones/CertificationsScreen.astro';
import PendingScreen from '@components/terminal/PendingScreen.astro';
import { directives, type Directive } from '@data/site';
import { IDIOMAS } from '@i18n';

export function getStaticPaths() {
  return IDIOMAS.flatMap((lang) =>
    directives.map((directive) => ({
      params: { lang, directiva: directive.slugs[lang] },
      props: { directive },
    })),
  );
}

const { directive } = Astro.props as { directive: Directive };
---

{
  directive.id === 'perfil' ? (
    <ProfileScreen directive={directive} />
  ) : directive.id === 'certificaciones' ? (
    <CertificationsScreen directive={directive} />
  ) : directive.id === 'acerca-de-mi' ? (
    <AboutScreen directive={directive} />
  ) : (
    <PendingScreen directive={directive} />
  )
}

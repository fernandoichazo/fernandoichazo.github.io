---
import TerminalLayout from '@layouts/TerminalLayout.astro';
import TerminalHeader from '@components/terminal/TerminalHeader.astro';
import HeroIntro from '@components/hero/HeroIntro.astro';
import NavTabs from '@components/terminal/NavTabs.astro';
import { PersonalService } from '@services/perfil';
import { idiomaDe, rutasPorIdioma, traducir } from '@i18n';

export const getStaticPaths = rutasPorIdioma;

const idioma = idiomaDe(Astro);
const personal = await PersonalService.getPersonal(idioma);
---

<TerminalLayout
  title={`${personal.nombreCompleto} · ${personal.titular}`}
  description={traducir(idioma).meta.inicioDescripcion(personal.nombreCompleto, personal.titular)}
  pagina="inicio"
  boot
>
  <TerminalHeader />
  <HeroIntro personal={personal} />
  <NavTabs />
</TerminalLayout>

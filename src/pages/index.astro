---
import TerminalLayout from '@layouts/TerminalLayout.astro';
import TerminalHeader from '@components/terminal/TerminalHeader.astro';
import HeroIntro from '@components/hero/HeroIntro.astro';
import NavTabs from '@components/terminal/NavTabs.astro';
import { profile } from '@data/site';
---

<TerminalLayout
  title={`${profile.name} · ${profile.role}`}
  description={`Portafolio de ${profile.name}, ${profile.role}. Proyectos, certificaciones y perfil profesional.`}
  boot
>
  <TerminalHeader />
  <HeroIntro />
  <NavTabs />
</TerminalLayout>

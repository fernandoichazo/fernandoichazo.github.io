---
import TerminalLayout from '@layouts/TerminalLayout.astro';
import TerminalHeader from '@components/terminal/TerminalHeader.astro';
import HeroIntro from '@components/hero/HeroIntro.astro';
import NavTabs from '@components/terminal/NavTabs.astro';
import { PersonalService } from '@services/perfil';

const personal = await PersonalService.getPersonal();
---

<TerminalLayout
  title={`${personal.nombreCompleto} · ${personal.titular}`}
  description={`Portafolio de ${personal.nombreCompleto}, ${personal.titular}. Proyectos, certificaciones y perfil profesional.`}
  boot
>
  <TerminalHeader />
  <HeroIntro personal={personal} />
  <NavTabs />
</TerminalLayout>

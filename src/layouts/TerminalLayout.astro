---
// Layout base Pip-OS: documento, preferencias CRT antes de pintar, intro del Pip-Boy,
// tubo, marco y barra de estado.
import '@styles/global.css';
import '@styles/transitions.css';
import CRTScreen from '@components/crt/CRTScreen.astro';
import PipBoyFrame from '@components/pipboy/PipBoyFrame.astro';
import PipBoyIntro from '@components/pipboy/PipBoyIntro.astro';
import SystemStatus from '@components/hero/SystemStatus.astro';
import vt323 from '@fontsource/vt323/files/vt323-latin-400-normal.woff2?url';
import shareTechMono from '@fontsource/share-tech-mono/files/share-tech-mono-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  boot?: boolean;
  statusMessage?: string;
  statusMessageMid?: string;
  statusMessageShort?: string;
}

const { title, description, boot = false, statusMessage, statusMessageMid, statusMessageShort } = Astro.props;
---

<!doctype html>
<html lang="es" data-crt="on" data-sound="off" data-boot={boot ? 'pending' : 'off'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#615f42" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preload" href={vt323} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={shareTechMono} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var read = function (key) {
          try {
            return localStorage.getItem(key);
          } catch (e) {
            return null;
          }
        };
        if (read('pipos:crt') === 'off') root.dataset.crt = 'off';
        if (read('pipos:sound') === 'on') root.dataset.sound = 'on';
        if (root.dataset.boot === 'pending') {
          var booted = null;
          try {
            booted = sessionStorage.getItem('pipos:booted');
          } catch (e) {}
          var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          root.dataset.boot = booted || still ? 'off' : 'run';
        }
        // Cambio de pantalla entre páginas (src/styles/transitions.css): volver al menú
        // principal rueda la imagen; entrar a un apartado colapsa y reabre el tubo.
        window.addEventListener('pagereveal', function (event) {
          var transition = event.viewTransition;
          if (!transition || !transition.types) return;
          var path = location.pathname.replace(/index\.html$/, '');
          transition.types.add(path === '/' || path === '' ? 'pipos-back' : 'pipos-forward');
        });
        // [ESC] vuelve al menú. Va aquí (inline, antes de pintar) y no en un módulo para que
        // funcione desde el primer instante, aún durante la animación de entrada. preventDefault
        // evita que el navegador use ESC para "detener la carga" y cancele la navegación.
        var leaving = false;
        window.addEventListener(
          'keydown',
          function (event) {
            if (event.key !== 'Escape' || leaving) return;
            if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
            var target = event.target;
            if (target && target.closest && target.closest('input, textarea, select, [contenteditable]')) return;
            if (root.dataset.boot === 'run') return; // la intro del Pip-Boy usa ESC para saltarse
            // El botón está al final del body: si aún no se parseó, se vuelve igual al menú.
            var back = document.querySelector('[data-back]');
            var home = location.pathname === '/' || location.pathname === '/index.html';
            if (!back && home) return;
            event.preventDefault();
            leaving = true;
            location.assign(back ? back.href : '/');
          },
          true
        );
        // Al volver con el botón "atrás" desde la caché del navegador, se puede salir otra vez.
        window.addEventListener('pageshow', function () {
          leaving = false;
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {boot && <PipBoyIntro />}
    <CRTScreen>
      <main id="contenido" class="main">
        <slot />
      </main>
      <SystemStatus message={statusMessage} messageMid={statusMessageMid} messageShort={statusMessageShort} />
    </CRTScreen>
    <PipBoyFrame />
  </body>
</html>

<style>
  .main {
    min-width: 0;
    padding-bottom: 0;
  }
</style>
